{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest"],
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "paths": {
      "@domain/*": ["domain/*"],
      "@usecase/*": ["usecase/*"],
      "@repository/*": ["repository/*"],
      "@delivery/*": ["delivery/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}